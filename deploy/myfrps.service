[Unit]
Description=my-frp TCP tunnel server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=myfrp
Group=myfrp
WorkingDirectory=/var/lib/myfrp-server
StateDirectory=myfrp-server
StateDirectoryMode=0700
ExecStart=/usr/local/bin/myfrps /etc/myfrp/server.json
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
